<%- include('partials/header', { title }) %>
<section class="page-heading">
  <p class="eyebrow">Directory</p>
  <h1>Organizations</h1>
  <p class="intro">Community groups making local projects happen.</p>
  <a class="button-link" href="/organizations/new">Add organization</a>
</section>
<% if (organizations.length) { %>
  <ul class="item-list">
    <% organizations.forEach((organization) => { %>
      <li class="item-row">
        <div>
          <h2><a href="/organization/<%= organization.id %>"><%= organization.name %></a></h2>
          <% if (organization.website) { %><p><a class="external-link" href="<%= organization.website %>" target="_blank" rel="noopener noreferrer"><%= organization.website %></a></p><% } %>
        </div>
        <a class="text-link" href="/organization/<%= organization.id %>">View organization <span aria-hidden="true">→</span></a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p class="empty-state">No organizations have been added yet.</p>
<% } %>
<%- include('partials/footer') %>