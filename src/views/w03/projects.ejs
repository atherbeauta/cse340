<%- include('partials/header', { title }) %>
<section class="page-heading">
  <p class="eyebrow">Directory</p>
  <h1>Projects</h1>
  <p class="intro">Explore the work happening across the community.</p>
  <a class="button-link" href="/projects/new">Add project</a>
</section>
<% if (projects.length) { %>
  <ul class="item-list">
    <% projects.forEach((project) => { %>
      <li class="item-row">
        <div>
          <h2><a href="/project/<%= project.id %>"><%= project.name %></a></h2>
          <p><%= project.description || 'No description provided.' %></p>
          <p class="meta"><%= project.date ? new Date(project.date).toLocaleDateString() : 'Date not scheduled' %><% if (project.organization_id) { %> · <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a><% } else { %> · Organization not assigned<% } %></p>
        </div>
        <a class="text-link" href="/project/<%= project.id %>">View project <span aria-hidden="true">→</span></a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p class="empty-state">No projects have been added yet.</p>
<% } %>
<%- include('partials/footer') %>