<%- include('partials/header', { title }) %>
<section class="page-heading">
  <p class="eyebrow">Directory</p>
  <h1>Categories</h1>
  <p class="intro">Browse projects by the kind of work they support.</p>
</section>
<% if (categories.length) { %>
  <ul class="item-list compact-list">
    <% categories.forEach((category) => { %>
      <li class="item-row">
        <h2><a href="/category/<%= category.id %>"><%= category.name %></a></h2>
        <a class="text-link" href="/category/<%= category.id %>">View projects <span aria-hidden="true">→</span></a>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p class="empty-state">No categories have been added yet.</p>
<% } %>
<%- include('partials/footer') %>