<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4f5f1">
    <title><%= title %> | Community Projects</title>
    <link rel="stylesheet" href="/w03.css">
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Community Projects home">Community<span>Projects</span></a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/organizations">Organizations</a>
        <a href="/projects">Projects</a>
        <a href="/categories">Categories</a>
      </nav>
    </header>
    <main class="page-content">
      <% if (typeof success !== 'undefined' && success.length) { %>
        <div class="flash-message success" role="status"><% success.forEach((message) => { %><p><%= message %></p><% }) %></div>
      <% } %>
      <% if (typeof error !== 'undefined' && error.length) { %>
        <div class="flash-message error" role="alert"><% error.forEach((message) => { %><p><%= message %></p><% }) %></div>
      <% } %>