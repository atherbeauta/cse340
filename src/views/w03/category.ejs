<%- include('partials/header', { title }) %>
<p class="breadcrumb"><a href="/categories">Categories</a> <span aria-hidden="true">/</span> <%= category.name %></p>
<section class="detail-heading">
  <p class="eyebrow">Category</p>
  <h1><%= category.name %></h1>
  <a class="button-link" href="/categories/<%= category.id %>/edit">Edit category</a>
</section>
<section class="related-section">
  <div class="section-heading"><h2>Projects in this category</h2><span class="count"><%= projects.length %></span></div>
  <% if (projects.length) { %>
    <ul class="item-list">
      <% projects.forEach((project) => { %>
        <li class="item-row">
          <div><h3><a href="/project/<%= project.id %>"><%= project.name %></a></h3><p><%= project.description || 'No description provided.' %></p><p class="meta"><%= project.date ? new Date(project.date).toLocaleDateString() : 'Date not scheduled' %></p></div>
          <a class="text-link" href="/project/<%= project.id %>">View project <span aria-hidden="true">→</span></a>
        </li>
      <% }) %>
    </ul>
  <% } else { %><p class="empty-state">No projects are assigned to this category.</p><% } %>
</section>
<%- include('partials/footer') %>