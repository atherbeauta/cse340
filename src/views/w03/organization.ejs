<%- include('partials/header', { title }) %>
<p class="breadcrumb"><a href="/organizations">Organizations</a> <span aria-hidden="true">/</span> <%= organization.name %></p>
<section class="detail-heading">
  <p class="eyebrow">Organization</p>
  <h1><%= organization.name %></h1>
  <a class="button-link" href="/organizations/<%= organization.id %>/edit">Edit organization</a>
  <% if (organization.website) { %><a class="external-link" href="<%= organization.website %>" target="_blank" rel="noopener noreferrer"><%= organization.website %> <span aria-hidden="true">↗</span></a><% } %>
</section>
<section class="related-section">
  <div class="section-heading"><h2>Projects</h2><span class="count"><%= projects.length %></span></div>
  <% if (projects.length) { %>
    <ul class="item-list">
      <% projects.forEach((project) => { %>
        <li class="item-row">
          <div><h3><a href="/project/<%= project.id %>"><%= project.name %></a></h3><p><%= project.description || 'No description provided.' %></p></div>
          <a class="text-link" href="/project/<%= project.id %>">View project <span aria-hidden="true">→</span></a>
        </li>
      <% }) %>
    </ul>
  <% } else { %><p class="empty-state">This organization has no associated projects yet.</p><% } %>
</section>
<%- include('partials/footer') %>