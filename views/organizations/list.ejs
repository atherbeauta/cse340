<%- include('../partials/header', { title: 'Organizations' }) %>
<section>
  <div class="section-header">
    <h2>Organizations</h2>
    <p>Use the edit links for each organization and the button below to add a new organization inside this section.</p>
  </div>

  <div class="image-grid">
    <figure class="image-card">
      <img src="/images/organization-1.svg" alt="Community Center" />
      <figcaption>Hope Community Center</figcaption>
    </figure>
    <figure class="image-card">
      <img src="/images/organization-2.svg" alt="Health Network" />
      <figcaption>Valley Health Network</figcaption>
    </figure>
    <figure class="image-card">
      <img src="/images/organization-3.svg" alt="Volunteer Program" />
      <figcaption>Volunteer Outreach</figcaption>
    </figure>
  </div>

  <ul>
    <% organizations.forEach(function(org){ %>
      <li>
        <strong><a href="/organizations/<%= org.id %>"><%= org.name %></a></strong>
        <a href="/edit-organization/<%= org.id %>">Edit</a>
      </li>
    <% }) %>
  </ul>
  <a class="button" href="/new-organization">Create new organization</a>
</section>
<%- include('../partials/footer') %>
