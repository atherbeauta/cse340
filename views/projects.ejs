<%- include('partials/header') %>

<main class="page-content projects-page">
    <section class="section-header">
        <h2>Projects</h2>
        <p>Browse the full list of projects, their organization, and the categories they support.</p>
    </section>

    <ul class="project-grid">
        <% projects.forEach(function(project) { %>
            <li class="project-card">
                <a href="/project/<%= project.id %>"><h3><%= project.name %></h3></a>
                <p><%= project.description %></p>
                <p class="meta"><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name || project.organization %></a></p>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
