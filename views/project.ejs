<%- include('partials/header') %>

<main class="page-content project-page">
    <section class="section-header">
        <h2><%= project.name %></h2>
        <p><%= project.description %></p>
    </section>

    <section class="project-meta">
        <p><strong>Date:</strong> <%= project.date %></p>
        <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
        <p><strong>Categories:</strong>
            <% if (project.categories && project.categories.length) { %>
                <% project.categories.forEach(function(cat) { %>
                    <a class="tag" href="/category/<%= cat.id %>"><%= cat.name %></a>
                <% }); %>
            <% } else { %>
                <span>Uncategorized</span>
            <% } %>
        </p>
    </section>
</main>

<%- include('partials/footer') %>
